<?xml version="1.0"?>
<mavlink>

    <version>1.0</version>
    <dialect>examples</dialect>

    <enums>
        <enum name="MAV_SYSTEM_TYPE">
            <description>System type enumeration</description>
            <entry value="0" name="GROUND_STATION"/>
            <entry value="1" name="ROCKET"/>
            <entry value="2" name="REMOTE_FILLING_STATION"/>
        </enum>
    </enums>

    <messages>
        <message id="1" name="HEARTBEAT">
            <description>System heartbeat message</description>
            <field type="uint8_t" name="system_type" enum="MAV_SYSTEM_TYPE">Type of system (MAV_SYSTEM_TYPE enum)</field>
            <field type="uint64_t" name="uptime" units="ms">System uptime (ms)</field>
        </message>
    </messages>
</mavlink>
